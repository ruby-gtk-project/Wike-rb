<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ported from upstream's data/com.github.hugolabe.Wike.metainfo.xml.in.

  Keeps the id, launchable and description describing the app this port
  behaves like — this is the same Wike, read as a Ruby GTK4/Libadwaita
  client of the Wikipedia API rather than Python/GTK4. The source and
  bug tracker point at this fork, since that is where this build's code
  and issues actually live; the release history is this port's own,
  starting from its first packaged version rather than carrying upstream's
  Python release notes forward.
-->
<component type="desktop-application">
  <id>com.github.hugolabe.Wike</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Wike</name>
  <summary>Search and read Wikipedia articles</summary>

  <description>
    <p>
      Wike is a Wikipedia reader for the GNOME Desktop.
      Provides access to all the content of this online encyclopedia in a native application,
      with a simpler and distraction-free view of articles.
    </p>
    <p>
      It supports more than 300 languages and integrates with desktop searches,
      providing suggestions that make it easier to find any content.
      Other features are: bookmarks with multiple lists, article table of contents,
      history, text searches and much more…
    </p>
  </description>

  <launchable type="desktop-id">com.github.hugolabe.Wike.desktop</launchable>
  <translation type="gettext">wike</translation>
  <content_rating type="oars-1.1" />

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/hugolabe/wike/master/data/screenshots/wike-01.png</image>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/hugolabe/wike/master/data/screenshots/wike-02.png</image>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/hugolabe/wike/master/data/screenshots/wike-03.png</image>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/hugolabe/wike/master/data/screenshots/wike-04.png</image>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/hugolabe/wike/master/data/screenshots/wike-05.png</image>
    </screenshot>
  </screenshots>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>

  <branding>
    <color type="primary" scheme_preference="light">#dbeede</color>
    <color type="primary" scheme_preference="dark">#3b608c</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-11-07">
      <description translate="no">
        <p>Initial Ruby GTK4 / Libadwaita port of Wike.</p>
      </description>
    </release>
  </releases>

  <url type="homepage">https://hugolabe.github.io/Wike/</url>
  <url type="bugtracker">https://github.com/ruby-gtk-project/Wike-rb/issues</url>
  <url type="contribute">https://hugolabe.github.io/Wike/#foss</url>
  <url type="vcs-browser">https://github.com/ruby-gtk-project/Wike-rb</url>
  <url type="translate">https://poeditor.com/join/project?hash=kNgJu4MAum</url>
  <!-- developer_name tag deprecated with Appstream 1.0 -->
  <developer_name translate="no">Hugo Olabera</developer_name>
  <developer id="io.github.hugolabe">
    <name translate="no">Hugo Olabera</name>
  </developer>
</component>
