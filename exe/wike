#!/usr/bin/env ruby
# frozen_string_literal: true

require "wike"

# `--url`, the option the shell search provider passes to hand a result
# straight to the running (or newly started) app, is parsed by GLib itself
# now (see Wike::Application#build) rather than by hand here, since only
# GLib's own option parsing is what gets the argument forwarded to an
# already-running instance at all.
Wike::Application.new.build.run
